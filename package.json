{
  "name": "confidential-vesting-credit",
  "description": "Production-grade confidential vesting-backed credit protocol built with Zama fhEVM",
  "version": "0.1.0",
  "main": "dist/protocolSdk.js",
  "types": "dist/protocolSdk.d.ts",
  "exports": {
    "./protocol-sdk": {
      "types": "./dist/protocolSdk.d.ts",
      "default": "./dist/protocolSdk.js"
    }
  },
  "engines": {
    "node": ">=20",
    "npm": ">=7.0.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/zama-ai/fhevm-hardhat-template/README.md",
  "keywords": [
    "fhevm",
    "zama",
    "eth",
    "ethereum",
    "dapps",
    "wallet",
    "web3",
    "typescript",
    "hardhat"
  ],
  "dependencies": {
    "@fhevm/mock-utils": "^0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "@metamask/connect-evm": "^2.1.0",
    "@openzeppelin/confidential-contracts": "^0.5.1",
    "@tokenops/sdk": "^1.1.1",
    "@zama-fhe/sdk": "^3.2.0",
    "encrypted-types": "^0.0.4",
    "viem": "^2.54.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@playwright/test": "^1.61.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.30",
    "@zama-fhe/relayer-sdk": "^0.4.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.16.0",
    "globals": "^17.6.0",
    "hardhat": "^2.28.6",
    "hardhat-deploy": "^0.11.45",
    "hardhat-gas-reporter": "^2.3.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "rimraf": "^6.1.3",
    "solhint": "^6.2.1",
    "solidity-coverage": "^0.8.17",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "files": [
    "contracts",
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf ./fhevmTemp ./artifacts ./cache ./coverage ./types ./coverage.json ./dist && npm run typechain",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "coverage": "cross-env SOLIDITY_COVERAGE=true hardhat coverage --solcoverjs ./.solcover.js --temp artifacts --testfiles \"test/**/*.ts\" && npm run typechain",
    "lint": "npm run lint:sol && npm run lint:ts && npm run prettier:check",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint .",
    "prettier:check": "prettier --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "test": "hardhat test",
    "test:ui": "node scripts/ui-smoke.mjs",
    "build:wallet": "esbuild src/metamask-wallet.js --bundle --format=iife --global-name=CVCMetaMaskWalletBundle --outfile=public/vendor/cvc-metamask-wallet.js --target=es2020 --platform=browser --legal-comments=none --minify",
    "test:sepolia": "hardhat test --network sepolia",
    "demo:local": "hardhat run scripts/local-protocol-demo.ts --network hardhat",
    "build:ts": "cross-env NODE_OPTIONS=--max-old-space-size=2048 tsc --project tsconfig.json",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
    "chain": "hardhat node --network hardhat --no-deploy",
    "deploy:hardhat": "hardhat deploy --network hardhat",
    "deploy:core:hardhat": "hardhat deploy --network hardhat --tags Core",
    "deploy:demo:hardhat": "hardhat deploy --network hardhat --tags Demo",
    "deploy:localhost": "hardhat deploy --network localhost",
    "deploy:core:localhost": "hardhat deploy --network localhost --tags Core",
    "deploy:demo:localhost": "hardhat deploy --network localhost --tags Demo",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "deploy:core:sepolia": "hardhat deploy --network sepolia --tags Core",
    "deploy:demo:sepolia": "hardhat deploy --network sepolia --tags Demo",
    "manifest:hardhat": "hardhat run scripts/write-deployment-manifest.ts --network hardhat",
    "manifest:localhost": "hardhat run scripts/write-deployment-manifest.ts --network localhost",
    "manifest:sepolia": "hardhat run scripts/write-deployment-manifest.ts --network sepolia",
    "tokenops:manager:sepolia": "hardhat run scripts/tokenops-create-manager.cjs --network sepolia",
    "smoke:sepolia:erc7984": "hardhat run scripts/sepolia-erc7984-credit-smoke.ts --network sepolia",
    "smoke:sepolia:erc7984-commitment": "hardhat run scripts/sepolia-erc7984-commitment-smoke.ts --network sepolia",
    "smoke:sepolia:erc7984-wrong-amount": "hardhat run scripts/sepolia-erc7984-wrong-amount-smoke.ts --network sepolia",
    "smoke:sepolia:erc7984-unwrap": "hardhat run scripts/sepolia-erc7984-unwrap-smoke.ts --network sepolia",
    "smoke:sepolia:tokenops-collateral": "hardhat run scripts/sepolia-tokenops-collateral-smoke.cjs --network sepolia",
    "smoke:sepolia:loan-escrow": "hardhat run scripts/sepolia-loan-escrow-smoke.ts --network sepolia",
    "smoke:sepolia:match-settlement": "hardhat run scripts/sepolia-match-settlement-smoke.ts --network sepolia",
    "smoke:sepolia:failed-match": "cross-env CVC_MATCH_SMOKE_EXPECT_FAILURE=true hardhat run scripts/sepolia-match-settlement-smoke.ts --network sepolia",
    "smoke:sepolia:preferences": "hardhat run scripts/sepolia-preference-submit-smoke.ts --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "publish:web": "bash scripts/publish-web.sh"
  },
  "overrides": {
    "ws": "8.21.0",
    "ws@>=7.0.0 <7.5.10": ">=7.5.10",
    "axios@>=1.3.2 <=1.7.3": ">=1.7.4",
    "elliptic@>=4.0.0 <=6.5.6": ">=6.5.7",
    "elliptic@>=2.0.0 <=6.5.6": ">=6.5.7",
    "elliptic@>=5.2.1 <=6.5.6": ">=6.5.7",
    "micromatch@<4.0.8": ">=4.0.8",
    "elliptic@<6.6.0": ">=6.6.0",
    "elliptic@<6.5.6": ">=6.5.6",
    "undici@>=6.0.0 <6.21.1": ">=6.21.1 <7.0.0",
    "undici@>=4.5.0 <5.28.5": ">=5.28.5 <6.0.0",
    "elliptic@<=6.6.0": ">=6.6.1",
    "tar-fs@>=2.0.0 <2.1.2": ">=2.1.2",
    "axios@>=1.0.0 <1.8.2": ">=1.8.2",
    "axios@<0.29.1": ">=0.29.1",
    "cookie@<0.7.0": ">=0.7.0",
    "minimatch": "^3.1.2"
  }
}
